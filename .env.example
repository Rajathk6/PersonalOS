PORT=3000
# Host port Docker maps Postgres to. Set 5433 if something (e.g. system
# Postgres) already listens on 5432, and match it in DATABASE_URL.
PG_PORT=5432
DATABASE_URL=postgresql://personalos:personalos@localhost:5432/personalos
API_TOKEN=change-me
LOG_LEVEL=info
WORKER_POLL_MS=1000
WORKER_HEARTBEAT_S=15
WORKER_LEASE_S=60
WORKER_ENABLED=true
# WORKER_ID unset = machine hostname (no hard-coded identity; override per node)
OLLAMA_URL=http://127.0.0.1:11434
DEFAULT_MODEL=qwen2.5:3b
MODEL_TIMEOUT_MS=300000
